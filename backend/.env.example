# ---- Application ----
APP_NAME=DocsMind
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
FRONTEND_URL=http://localhost:5173

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=<GENERATE_A_SECURE_64_BYTE_HEX_KEY>
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=docsmind
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_DB=docsmind

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=120

# ---- AI & Vector Search ----
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_STORAGE_PATH=storage/qdrant
# Optional: Override with local Ollama endpoint
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2:3b
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- SMTP / Email ----
# Use your SMTP provider credentials (Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<YOUR_SMTP_EMAIL>
SMTP_PASSWORD=<YOUR_SMTP_APP_PASSWORD>
SMTP_FROM_EMAIL=<YOUR_FROM_EMAIL>
SMTP_FROM_NAME=DocsMind
SMTP_TLS=true
EMAILS_ENABLED=true

# ---- Google OAuth (optional) ----
# Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=http://localhost:8006/api/v1/auth/google/callback
