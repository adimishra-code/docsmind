# ---- Application ----
APP_NAME=DocsMind
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
FRONTEND_URL=http://localhost:5173

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=<GENERATE_A_SECURE_64_BYTE_HEX_KEY>
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=docsmind
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_DB=docsmind

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=120

# ---- Admin ----
# Comma-separated emails granted admin on login. This bootstraps the FIRST
# administrator; once in, they can promote others by email from the admin panel
# (/admin). Leave empty in environments where all admins are managed in-app.
ADMIN_EMAILS=

# ---- AI & Vector Search ----
# LLM execution path (see app/services/rag/llm_provider.py):
#   openrouter -> OpenRouter (free models available, needs OPENAI_API_KEY=sk-or-v1-...)
#   openai     -> hosted OpenAI (needs a real OPENAI_API_KEY), OR any
#                 OpenAI-compatible server when LLM_BASE_URL is set
#   ollama     -> local Ollama server, no API key required
#   local      -> in-process HuggingFace transformers, no key / no network
LLM_PROVIDER=openrouter
OPENAI_API_KEY=<YOUR_OPENROUTER_OR_OPENAI_API_KEY>
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Qdrant Vector Store:
#   Leave QDRANT_URL empty to run embedded directly on local disk (no Docker needed!)
#   Or set to Qdrant Cloud or local server: http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_STORAGE_PATH=storage/qdrant

# Embedding Provider:
#   sentence_transformers -> runs 100% locally on CPU via PyTorch (zero API cost, no Docker!)
#   openai                -> hosted OpenAI text-embedding-3-small
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- SMTP / Email ----
# Use your SMTP provider credentials (Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<YOUR_SMTP_EMAIL>
SMTP_PASSWORD=<YOUR_SMTP_APP_PASSWORD>
SMTP_FROM_EMAIL=<YOUR_FROM_EMAIL>
SMTP_FROM_NAME=DocsMind
SMTP_TLS=true
EMAILS_ENABLED=true

# ---- Google OAuth (optional) ----
# Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=http://localhost:8006/api/v1/auth/google/callback
